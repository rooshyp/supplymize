{
  "components": {
    "schemas": {
      "ComponentContributions": {
        "additionalProperties": false,
        "description": "Weighted candidate values that sum to the point forecast.",
        "properties": {
          "event": {
            "title": "Event",
            "type": "number"
          },
          "history": {
            "title": "History",
            "type": "number"
          },
          "seasonality": {
            "title": "Seasonality",
            "type": "number"
          },
          "supplier_speed": {
            "title": "Supplier Speed",
            "type": "number"
          },
          "trend": {
            "title": "Trend",
            "type": "number"
          },
          "weather": {
            "title": "Weather",
            "type": "number"
          }
        },
        "required": [
          "history",
          "trend",
          "seasonality",
          "weather",
          "event",
          "supplier_speed"
        ],
        "title": "ComponentContributions",
        "type": "object"
      },
      "ConfidenceSummary": {
        "additionalProperties": false,
        "description": "Quality and uncertainty metadata for the forecast.",
        "properties": {
          "interpretation": {
            "enum": [
              "low",
              "moderate",
              "high"
            ],
            "title": "Interpretation",
            "type": "string"
          },
          "level": {
            "maximum": 0.99,
            "minimum": 0.5,
            "title": "Level",
            "type": "number"
          },
          "method": {
            "const": "normal-residual-with-horizon-growth",
            "title": "Method",
            "type": "string"
          },
          "residual_rmse": {
            "minimum": 0.0,
            "title": "Residual Rmse",
            "type": "number"
          },
          "score": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score",
            "type": "number"
          }
        },
        "required": [
          "level",
          "score",
          "residual_rmse",
          "method",
          "interpretation"
        ],
        "title": "ConfidenceSummary",
        "type": "object"
      },
      "DemandObservation": {
        "additionalProperties": false,
        "description": "One observed demand value; the date is optional for ordered series.",
        "properties": {
          "date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Observation date. Either provide a date for every point or for none.",
            "title": "Date"
          },
          "demand": {
            "description": "Observed units demanded. The alias 'quantity' is accepted.",
            "minimum": 0.0,
            "title": "Demand",
            "type": "number"
          },
          "stockout": {
            "default": false,
            "description": "Marks a censored observation that may understate true demand.",
            "title": "Stockout",
            "type": "boolean"
          }
        },
        "required": [
          "demand"
        ],
        "title": "DemandObservation",
        "type": "object"
      },
      "DriverExplanation": {
        "additionalProperties": false,
        "description": "Aggregate contribution from one ensemble driver.",
        "properties": {
          "adjustment_from_history_level": {
            "title": "Adjustment From History Level",
            "type": "number"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "direction": {
            "enum": [
              "down",
              "neutral",
              "up"
            ],
            "title": "Direction",
            "type": "string"
          },
          "driver": {
            "enum": [
              "history",
              "trend",
              "seasonality",
              "weather",
              "event",
              "supplier_speed"
            ],
            "title": "Driver",
            "type": "string"
          },
          "weight": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Weight",
            "type": "number"
          },
          "weighted_contribution": {
            "title": "Weighted Contribution",
            "type": "number"
          }
        },
        "required": [
          "driver",
          "weight",
          "weighted_contribution",
          "adjustment_from_history_level",
          "direction",
          "detail"
        ],
        "title": "DriverExplanation",
        "type": "object"
      },
      "ForecastPoint": {
        "additionalProperties": false,
        "description": "One explainable point estimate and prediction interval.",
        "properties": {
          "components": {
            "$ref": "#/components/schemas/ComponentContributions"
          },
          "date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date"
          },
          "demand": {
            "minimum": 0.0,
            "title": "Demand",
            "type": "number"
          },
          "lower_bound": {
            "minimum": 0.0,
            "title": "Lower Bound",
            "type": "number"
          },
          "step": {
            "title": "Step",
            "type": "integer"
          },
          "upper_bound": {
            "minimum": 0.0,
            "title": "Upper Bound",
            "type": "number"
          }
        },
        "required": [
          "step",
          "date",
          "demand",
          "lower_bound",
          "upper_bound",
          "components"
        ],
        "title": "ForecastPoint",
        "type": "object"
      },
      "ForecastRequest": {
        "additionalProperties": false,
        "description": "Demand forecast request accepted by ``POST /v1/forecasts``.",
        "properties": {
          "as_of_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Date immediately before forecast step one when history is not dated.",
            "title": "As Of Date"
          },
          "confidence_level": {
            "default": 0.9,
            "maximum": 0.99,
            "minimum": 0.5,
            "title": "Confidence Level",
            "type": "number"
          },
          "history": {
            "description": "Oldest-to-newest numeric demand values or dated demand objects.",
            "items": {
              "anyOf": [
                {
                  "minimum": 0.0,
                  "type": "number"
                },
                {
                  "$ref": "#/components/schemas/DemandObservation"
                }
              ]
            },
            "maxItems": 5000,
            "minItems": 3,
            "title": "History",
            "type": "array"
          },
          "horizon": {
            "default": 14,
            "description": "Forecast horizon in days.",
            "maximum": 365.0,
            "minimum": 1.0,
            "title": "Horizon",
            "type": "integer"
          },
          "location": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location"
          },
          "signals": {
            "$ref": "#/components/schemas/ForecastSignals"
          },
          "sku": {
            "examples": [
              "SKU-1042"
            ],
            "maxLength": 128,
            "minLength": 1,
            "title": "Sku",
            "type": "string"
          },
          "weights": {
            "$ref": "#/components/schemas/SignalWeights"
          }
        },
        "required": [
          "sku",
          "history"
        ],
        "title": "ForecastRequest",
        "type": "object"
      },
      "ForecastResponse": {
        "additionalProperties": false,
        "description": "Stable, deterministic response for a single SKU forecast.",
        "properties": {
          "assumptions": {
            "items": {
              "type": "string"
            },
            "title": "Assumptions",
            "type": "array"
          },
          "confidence": {
            "$ref": "#/components/schemas/ConfidenceSummary"
          },
          "explanations": {
            "items": {
              "$ref": "#/components/schemas/DriverExplanation"
            },
            "title": "Explanations",
            "type": "array"
          },
          "forecast": {
            "$ref": "#/components/schemas/ForecastResult"
          },
          "history_points_used": {
            "title": "History Points Used",
            "type": "integer"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "sku": {
            "title": "Sku",
            "type": "string"
          }
        },
        "required": [
          "model_version",
          "sku",
          "location",
          "history_points_used",
          "forecast",
          "confidence",
          "explanations",
          "assumptions"
        ],
        "title": "ForecastResponse",
        "type": "object"
      },
      "ForecastResult": {
        "additionalProperties": false,
        "description": "Horizon-level forecast result.",
        "properties": {
          "average_daily_demand": {
            "minimum": 0.0,
            "title": "Average Daily Demand",
            "type": "number"
          },
          "points": {
            "items": {
              "$ref": "#/components/schemas/ForecastPoint"
            },
            "title": "Points",
            "type": "array"
          },
          "total_demand": {
            "minimum": 0.0,
            "title": "Total Demand",
            "type": "number"
          },
          "total_lower_bound": {
            "minimum": 0.0,
            "title": "Total Lower Bound",
            "type": "number"
          },
          "total_upper_bound": {
            "minimum": 0.0,
            "title": "Total Upper Bound",
            "type": "number"
          }
        },
        "required": [
          "total_demand",
          "average_daily_demand",
          "total_lower_bound",
          "total_upper_bound",
          "points"
        ],
        "title": "ForecastResult",
        "type": "object"
      },
      "ForecastSignals": {
        "additionalProperties": false,
        "description": "Optional external drivers blended with signals inferred from history.",
        "properties": {
          "event": {
            "items": {
              "$ref": "#/components/schemas/ImpactSignal"
            },
            "maxItems": 365,
            "title": "Event",
            "type": "array"
          },
          "seasonality": {
            "anyOf": [
              {
                "items": {
                  "exclusiveMinimum": 0.0,
                  "maximum": 5.0,
                  "type": "number"
                },
                "maxItems": 366,
                "minItems": 2,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Repeating relative factors beginning at forecast step one; factors are normalized to a mean of 1.0. If omitted, seasonality is inferred from history.",
            "title": "Seasonality"
          },
          "supplier_speed": {
            "items": {
              "$ref": "#/components/schemas/SupplierSpeedSignal"
            },
            "maxItems": 365,
            "title": "Supplier Speed",
            "type": "array"
          },
          "trend": {
            "anyOf": [
              {
                "maximum": 0.25,
                "minimum": -0.25,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional daily growth rate. If omitted, a robust linear trend is inferred.",
            "title": "Trend"
          },
          "weather": {
            "items": {
              "$ref": "#/components/schemas/ImpactSignal"
            },
            "maxItems": 365,
            "title": "Weather",
            "type": "array"
          }
        },
        "title": "ForecastSignals",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ImpactSignal": {
        "additionalProperties": false,
        "description": "Expected fractional demand impact for one or all forecast periods.",
        "properties": {
          "confidence": {
            "default": 1,
            "description": "Confidence applied to the impact before it enters the ensemble.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional target forecast date.",
            "title": "Date"
          },
          "impact": {
            "description": "Expected fractional demand impact; 0.10 represents a 10% uplift.",
            "maximum": 1.0,
            "minimum": -1.0,
            "title": "Impact",
            "type": "number"
          },
          "label": {
            "anyOf": [
              {
                "maxLength": 120,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "step": {
            "anyOf": [
              {
                "maximum": 365.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional one-based target forecast step.",
            "title": "Step"
          }
        },
        "required": [
          "impact"
        ],
        "title": "ImpactSignal",
        "type": "object"
      },
      "ModelInfoResponse": {
        "additionalProperties": false,
        "properties": {
          "deterministic": {
            "title": "Deterministic",
            "type": "boolean"
          },
          "drivers": {
            "items": {
              "type": "string"
            },
            "title": "Drivers",
            "type": "array"
          },
          "maximum_horizon": {
            "title": "Maximum Horizon",
            "type": "integer"
          },
          "method": {
            "title": "Method",
            "type": "string"
          },
          "minimum_history_points": {
            "title": "Minimum History Points",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "method",
          "drivers",
          "deterministic",
          "minimum_history_points",
          "maximum_horizon"
        ],
        "title": "ModelInfoResponse",
        "type": "object"
      },
      "SignalWeights": {
        "additionalProperties": false,
        "description": "Auditable weights for the six-candidate forecasting ensemble.",
        "properties": {
          "event": {
            "default": 0.08,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Event",
            "type": "number"
          },
          "history": {
            "default": 0.5,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "History",
            "type": "number"
          },
          "seasonality": {
            "default": 0.15,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Seasonality",
            "type": "number"
          },
          "supplier_speed": {
            "default": 0.04,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Supplier Speed",
            "type": "number"
          },
          "trend": {
            "default": 0.15,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Trend",
            "type": "number"
          },
          "weather": {
            "default": 0.08,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Weather",
            "type": "number"
          }
        },
        "title": "SignalWeights",
        "type": "object"
      },
      "SupplierSpeedSignal": {
        "additionalProperties": false,
        "description": "Supplier velocity represented directly or derived from lead-time change.\n\nPositive ``speed_index`` means faster supply and a positive availability effect;\nnegative means slower supply. When lead times are supplied, the index is derived\nas ``(baseline_lead_time_days - lead_time_days) / baseline_lead_time_days``.",
        "properties": {
          "baseline_lead_time_days": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 3650.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Baseline Lead Time Days"
          },
          "confidence": {
            "default": 1,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date"
          },
          "lead_time_days": {
            "anyOf": [
              {
                "maximum": 3650.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lead Time Days"
          },
          "speed_index": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": -1.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Speed Index"
          },
          "step": {
            "anyOf": [
              {
                "maximum": 365.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Step"
          },
          "supplier": {
            "anyOf": [
              {
                "maxLength": 120,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Supplier"
          }
        },
        "title": "SupplierSpeedSignal",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "A deterministic forecasting boundary that blends demand history, trend, seasonality, weather, events, and supplier speed with auditable weights.",
    "license": {
      "name": "MIT"
    },
    "summary": "Explainable multi-signal demand forecasting for resilient supply chains.",
    "title": "SupplyMize Forecasting API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "health_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "operations"
        ]
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readiness_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "operations"
        ]
      }
    },
    "/v1/forecasts": {
      "post": {
        "operationId": "create_forecast_v1_forecasts_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForecastRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForecastResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "description": "The request schema or forecasting series is invalid."
          }
        },
        "summary": "Create an explainable demand forecast",
        "tags": [
          "forecasting"
        ]
      }
    },
    "/v1/model/info": {
      "get": {
        "operationId": "model_info_v1_model_info_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelInfoResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Describe the active deterministic model",
        "tags": [
          "forecasting"
        ]
      }
    }
  }
}
